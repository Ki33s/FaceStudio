<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FaceStudio — локальная замена лиц" Width="1240" Height="880" MinWidth="920" MinHeight="690" WindowStartupLocation="CenterScreen" Background="#111512" Foreground="#EFF3E9" FontFamily="Segoe UI" FontSize="14" AllowDrop="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Accent" Color="#C2F36B"/>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#EFF3E9"/><Setter Property="Background" Value="#293523"/><Setter Property="BorderBrush" Value="#46543C"/><Setter Property="Padding" Value="13,10"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Border" Property="Opacity" Value="0.45"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="#C2F36B"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#C2F36B"/><Setter Property="Foreground" Value="#17220E"/><Setter Property="BorderBrush" Value="#C2F36B"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#ACB6A4"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="8,6"/><Setter Property="FontSize" Value="12"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#111710"/><Setter Property="Foreground" Value="#EFF3E9"/><Setter Property="BorderBrush" Value="#46543C"/><Setter Property="Padding" Value="10,8"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Slider"><Setter Property="Foreground" Value="#C2F36B"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Height="20"><Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" Background="#C2F36B" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="11" Height="16"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#C2F36B" CornerRadius="4"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" Background="#34402D" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid x:Name="RootLayout" Margin="24,16,24,14">
  <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#C2F36B" CornerRadius="8" Width="39" Height="39" Margin="0,0,12,0"><TextBlock Text="◉" Foreground="#17220E" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="FaceStudio" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Ваши лица. Ваше видео." FontSize="12" Foreground="#939E92"/></StackPanel></StackPanel>
   <Button Grid.Column="1" x:Name="OpenButton" Content="Открыть видео" Style="{StaticResource Primary}" VerticalAlignment="Center"/>
  </Grid>
  <Grid Grid.Row="1" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
   <Grid><Grid.RowDefinitions><RowDefinition Height="*" MinHeight="235"/><RowDefinition Height="14"/><RowDefinition Height="190"/></Grid.RowDefinitions>
    <Border x:Name="DropArea" Background="#080B08" BorderBrush="#30382F" BorderThickness="1" CornerRadius="10" AllowDrop="True">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="86"/></Grid.RowDefinitions>
      <Border Background="#1A201B" CornerRadius="10,10,0,0" Padding="15,10"><StackPanel><TextBlock x:Name="FileName" Text="Видео ещё не открыто" Foreground="#EFF3E9" FontSize="13" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="FileDetails" Text="Загрузите видео для начала работы" FontSize="11" Foreground="#939E92" Margin="0,4,0,0"/></StackPanel></Border>
      <Grid Grid.Row="1" ClipToBounds="True">
       <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Close" Stretch="Uniform" ScrubbingEnabled="True"/>
       <Border x:Name="EmptyPanel" Background="#111710"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="18">
        <TextBlock x:Name="UploadIcon" Text="↥" FontSize="40" Foreground="#C2F36B" HorizontalAlignment="Center"/>
        <TextBlock Text="Перетащите сюда видео" FontSize="22" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,8"/>
        <TextBlock Text="или выберите файл на компьютере" Foreground="#939E92" TextAlignment="Center" TextWrapping="Wrap" FontSize="12"/>
        <Button x:Name="EmptyOpenButton" Content="Открыть видео" Style="{StaticResource Primary}" HorizontalAlignment="Center" Margin="0,20,0,0"/>
        <TextBlock x:Name="UploadFormats" Text="MP4 · MOV · MKV · AVI · WEBM и другие форматы" FontSize="10" Foreground="#7F8B77" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"/>
       </StackPanel></Border>
       <Border x:Name="PreviewOverlay" Background="#E8111512" Visibility="Collapsed"><TextBlock x:Name="PreviewMessage" Text="Подготовка предпросмотра…" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" Margin="24" Foreground="#C3D2B9"/></Border>
       <Border x:Name="DropHighlight" Background="#C0111710" BorderBrush="#C2F36B" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False"><TextBlock Text="Отпустите файл, чтобы открыть видео" TextWrapping="Wrap" TextAlignment="Center" FontSize="21" Foreground="#C2F36B" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"/></Border>
      </Grid>
      <Grid Grid.Row="2" Margin="12,6,12,9"><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Button x:Name="PlayButton" Content="▶" Width="38" Padding="5,2" IsEnabled="False" AutomationProperties.Name="Воспроизвести или приостановить"/>
       <TextBlock Grid.Column="1" x:Name="PositionLabel" Text="0:00 / 0:00" FontSize="12" Margin="10,0" VerticalAlignment="Center"/>
       <StackPanel Grid.Column="2" Orientation="Horizontal"><Button x:Name="MuteButton" Content="Звук вкл." Style="{StaticResource Quiet}"/><Button x:Name="SourceButton" Content="Исходник" Style="{StaticResource Quiet}" IsEnabled="False"/><Button x:Name="ResultButton" Content="Результат" Style="{StaticResource Quiet}" IsEnabled="False"/></StackPanel>
       <Slider x:Name="SeekSlider" Grid.Row="1" Grid.ColumnSpan="3" Minimum="0" Maximum="1000" IsMoveToPointEnabled="True" IsEnabled="False" VerticalAlignment="Center" AutomationProperties.Name="Перемотка видео"/>
      </Grid>
     </Grid>
    </Border>
    <Border Grid.Row="2" Background="#1A201B" BorderBrush="#30382F" BorderThickness="1" CornerRadius="10" Padding="16,12"><Grid><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="ПРОВЕРКА КАЧЕСТВА" Foreground="#C2F36B" FontSize="11"/><Button x:Name="CheckButton" Content="Проверить результат" Style="{StaticResource Quiet}" HorizontalAlignment="Right" Padding="8,2" IsEnabled="False"/><TextBox x:Name="Report" Grid.Row="1" IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0" VerticalScrollBarVisibility="Auto" FontSize="12" Text="Здесь появятся отчёт о замене лиц и результаты технической проверки."/></Grid></Border>
   </Grid>
   <Border Grid.Column="2" Background="#1A201B" BorderBrush="#30382F" BorderThickness="1" CornerRadius="10" Padding="18,16"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer x:Name="ControlScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <TextBlock Text="ЗАМЕНА ЛИЦ" Foreground="#C2F36B" FontSize="11"/><TextBlock Text="Назначьте новые лица" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,9"/>
    <TextBlock Text="Программа найдёт людей в видео. Выберите фотографию для каждого нужного человека." Foreground="#939E92" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,15"/>
    <Button x:Name="SwapButton" Content="Заменить лица" Style="{StaticResource Primary}" IsEnabled="False"/>
    <TextBlock Text="Приоритет качества · 512×512 · обработка дольше. Без фото — без замены." FontSize="11" Foreground="#839079" TextWrapping="Wrap" Margin="0,9,0,20"/>
    <Border Height="1" Background="#30382F" Margin="0,0,0,18"/>
    <TextBlock Text="ПОСЛЕ ПРОСМОТРА" Foreground="#C2F36B" FontSize="11"/><TextBlock Text="Что исправить?" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,10"/>
    <TextBox x:Name="Command" AcceptsReturn="True" MinHeight="104" Height="120" VerticalScrollBarVisibility="Auto" IsEnabled="False" AutomationProperties.Name="Описание исправления"/>
    <Button x:Name="RepairButton" Content="Исправить по описанию" Margin="0,10,0,0" IsEnabled="False"/><TextBlock Text="Ctrl+Enter — применить описание" FontSize="10" Foreground="#839079" Margin="0,8,0,18"/>
    <Button x:Name="SaveButton" Content="Сохранить результат  ↗" Style="{StaticResource Primary}" IsEnabled="False"/><Button x:Name="FolderButton" Content="Открыть папку" MinHeight="36" FontSize="12" Margin="0,8,0,8" IsEnabled="False"/>
    <Button x:Name="LastButton" Content="Открыть последний результат" FontSize="12"/>
   </StackPanel></ScrollViewer><Border Grid.Row="1" Background="#111710" CornerRadius="7" Padding="12" Margin="0,14,0,0"><StackPanel><TextBlock x:Name="Stage" Text="Подготовка…" FontSize="12" Foreground="#C3D2B9" TextWrapping="Wrap"/><ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Height="5" Foreground="#C2F36B" Background="#34402D" Margin="0,10,0,0"/><Button x:Name="CancelButton" Content="Отменить обработку" Style="{StaticResource Quiet}" Margin="0,7,0,0" IsEnabled="False"/></StackPanel></Border></Grid></Border>
  </Grid>
  <Grid Grid.Row="2" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="LocalStatus" Text="Проверка Ollama…" FontSize="11" Foreground="#939E92" TextTrimming="CharacterEllipsis" ToolTip="Обработка на вашем компьютере"/><TextBlock Grid.Column="1" Text="●  Локально" Foreground="#A8BC91" FontSize="11" Margin="14,0,0,0"/></Grid>
 </Grid>
</Window>
